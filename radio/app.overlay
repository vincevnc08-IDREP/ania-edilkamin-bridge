#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>
&pinctrl {
 ania_uart: ania_uart {
  group1 { pinmux = <UART1_RX_GPIO38>; input-enable; bias-pull-up; };
  group2 { pinmux = <UART1_TX_GPIO47>; output-enable; };
 };
};
&spi2 { status = "disabled"; };
&uart1 { status = "okay"; current-speed = <230400>; pinctrl-0 = <&ania_uart>; pinctrl-names = "default"; };
